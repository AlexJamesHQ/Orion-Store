<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Orion" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.Orion.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Orion</item>
    </style>
</resources>
